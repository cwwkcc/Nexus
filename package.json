{
  "name": "@nexus/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "prebuild": "pnpm --filter @nexus/config build && pnpm --filter @nexus/config generate && pnpm --filter @nexus/contracts exec tsc -p tsconfig.lib.json && pnpm --filter @nexus/api exec tsc -p tsconfig.lib.json && pnpm db:generate",
    "build": "pnpm prebuild && pnpm --filter @nexus/web build && pnpm --filter @nexus/admin build",
    "dev:web": "pnpm prebuild && pnpm --filter @nexus/web dev",
    "build:web": "pnpm prebuild && pnpm --filter @nexus/web build",
    "dev:admin": "pnpm prebuild && pnpm --filter @nexus/admin dev",
    "build:admin": "pnpm prebuild && pnpm --filter @nexus/admin build",
    "test": "pnpm --filter @nexus/ui test",
    "test:run": "pnpm --filter @nexus/ui test:run",
    "test:ui": "pnpm --filter @nexus/ui test:ui",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "docker:up": "docker compose build nexus-web && docker compose build nexus-admin && docker compose build migrate && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "db:generate": "pnpm --filter @nexus/db exec prisma generate",
    "db:migrate": "pnpm --filter @nexus/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @nexus/db exec prisma db seed",
    "db:studio": "pnpm --filter @nexus/db exec prisma studio",
    "db:push": "pnpm --filter @nexus/db exec prisma db push",
    "reset:hard": "pnpm docker:clean && pnpm docker:up && pnpm db:generate && pnpm db:migrate -- --name reset && pnpm db:seed",
    "reset:soft": "pnpm db:migrate -- --name reset && pnpm db:seed"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "4.0.4",
      "undici": "7.28.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1012.0",
    "@prisma/client": "7.8.0",
    "@sanity/client": "^7.18.0",
    "@sanity/image-url": "^2.0.3",
    "@trpc/client": "^11.13.4",
    "@trpc/server": "^11.13.4",
    "next": "~16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.6.0",
    "@nx/eslint-plugin": "22.6.0",
    "@nx/js": "22.6.0",
    "@nx/next": "22.6.0",
    "@nx/web": "22.6.0",
    "@nx/workspace": "22.6.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsonc-eslint-parser": "^3.1.0",
    "nx": "22.6.0",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
