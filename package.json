{
  "name": "@nexus/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "pnpm --filter @nexus/config build && pnpm --filter @nexus/config generate",
    "build": "pnpm prebuild && pnpm --filter @nexus/web build && pnpm --filter @nexus/admin build",
    "dev:web": "pnpm prebuild && pnpm --filter @nexus/web dev",
    "build:web": "pnpm prebuild && pnpm --filter @nexus/web build",
    "dev:admin": "pnpm prebuild && pnpm --filter @nexus/admin dev",
    "build:admin": "pnpm prebuild && pnpm --filter @nexus/admin build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1012.0",
    "@aws-sdk/s3-request-presigner": "^3.1012.0",
    "@prisma/client": "7.8.0",
    "@sanity/client": "^7.18.0",
    "@sanity/image-url": "^2.0.3",
    "@trpc/client": "^11.13.4",
    "@trpc/server": "^11.13.4",
    "next": "~16.2.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "22.6.0",
    "@nx/eslint-plugin": "22.6.0",
    "@nx/js": "22.6.0",
    "@nx/next": "22.6.0",
    "@nx/web": "22.6.0",
    "@nx/workspace": "22.6.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsonc-eslint-parser": "^3.1.0",
    "nx": "22.6.0",
    "postcss": "8.4.38",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
