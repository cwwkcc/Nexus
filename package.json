{
  "name": "@nexus/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "prebuild": "pnpm --filter @nexus/tokens build && pnpm --filter @nexus/contracts exec tsc -p tsconfig.lib.json && pnpm --filter @nexus/env build && pnpm --filter @nexus/config build && pnpm --filter @nexus/api exec tsc -p tsconfig.lib.json && pnpm --filter @nexus/transport exec tsc -p tsconfig.lib.json && pnpm db:generate",
    "build": "pnpm prebuild && pnpm --filter @nexus/web build && pnpm --filter @nexus/admin build",
    "dev:web": "pnpm prebuild && pnpm --filter @nexus/web dev",
    "build:web": "pnpm prebuild && pnpm --filter @nexus/web build",
    "dev:admin": "pnpm prebuild && pnpm --filter @nexus/admin dev",
    "build:admin": "pnpm prebuild && pnpm --filter @nexus/admin build",
    "test": "pnpm --filter @nexus/ui test",
    "test:run": "pnpm --filter @nexus/ui test:run",
    "test:ui": "pnpm --filter @nexus/ui test:ui",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "docker:up": "docker compose build nexus-web && docker compose build nexus-admin && docker compose build migrate && docker compose up -d",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "db:generate": "pnpm --filter @nexus/db exec prisma generate",
    "db:migrate": "pnpm --filter @nexus/db exec prisma migrate dev",
    "db:seed": "pnpm --filter @nexus/db exec prisma db seed",
    "db:studio": "pnpm --filter @nexus/db exec prisma studio",
    "db:push": "pnpm --filter @nexus/db exec prisma db push",
    "reset:hard": "pnpm docker:clean && pnpm docker:up && pnpm db:generate && pnpm db:migrate -- --name reset && pnpm db:seed",
    "reset:soft": "pnpm db:migrate -- --name reset && pnpm db:seed"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "4.0.4",
      "undici": "7.28.0",
      "adm-zip": ">=0.6.0",
      "sharp": ">=0.35.0",
      "brace-expansion": "5.0.7",
      "axios": "1.18.1",
      "esbuild": "0.28.1",
      "uuid": "14.0.1",
      "@hono/node-server": "2.0.11",
      "postcss": "^8.5.10"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@prisma/client": "7.8.0",
    "@sanity/client": "^7.24.0",
    "@sanity/image-url": "^2.1.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "next": "~16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.2.11",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/next": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.46",
    "@swc/helpers": "~0.5.23",
    "@types/node": "20.19.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.4.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsonc-eslint-parser": "^3.1.0",
    "nx": "23.1.0",
    "postcss": "^8.5.10",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
