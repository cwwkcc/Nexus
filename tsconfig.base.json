{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@nexus/source"],
    "paths": {
      "@nexus/ui": ["./packages/ui/src/index.ts"],
      "@nexus/api": ["./packages/api/src/index.ts"],
      "@nexus/db": ["./packages/database/src/index.ts"],
      "@nexus/config": ["./packages/config/src/index.ts"],
      "@/*": ["./apps/web/src/*"],
      "@/i18n/*": ["./apps/web/src/i18n/*"]
    }
  }
}
