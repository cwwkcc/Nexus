{
  "name": "@nexus/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.js",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.ts",
      "require": "./dist/tailwind/preset.js",
      "import": "./dist/tailwind/preset.js",
      "default": "./dist/tailwind/preset.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "generate:css-vars": "tsx scripts/generate-css-vars.js",
    "generate:cn": "tsx scripts/generate-cn-groups.js",
    "generate": "npm run generate:css-vars && npm run generate:cn"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@nexus/tokens": "workspace:*",
    "next": "16.2.9",
    "tailwindcss": "3.4.3"
  }
}
