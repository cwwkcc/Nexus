{
  "name": "@nexus/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "require": "./dist/next/index.js",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.ts",
      "require": "./dist/tailwind/preset.js",
      "import": "./dist/tailwind/preset.js",
      "default": "./dist/tailwind/preset.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "require": "./dist/fonts.js",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "require": "./dist/metadata.js",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "require": "./dist/paths.js",
      "import": "./dist/paths.js",
      "default": "./dist/paths.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "require": "./dist/cache.js",
      "import": "./dist/cache.js",
      "default": "./dist/cache.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "@nexus/env": "workspace:*",
    "@nexus/tokens": "workspace:*",
    "next": "16.2.9",
    "tailwindcss": "3.4.3",
    "tsup": "8.5.1"
  }
}
