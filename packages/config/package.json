{
  "name": "@nexus/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "@nexus/source": "./src/index.ts",
      "require": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "generate:css-vars": "tsx scripts/generate-css-vars.js",
    "generate:cn": "tsx scripts/generate-cn-groups.js",
    "generate": "npm run generate:css-vars && npm run generate:cn"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "tailwindcss": "3.4.3"
  }
}
