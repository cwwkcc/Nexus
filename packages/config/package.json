{
  "name": "@nexus/config",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "require": "./dist/next.js",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "require": "./dist/env.js",
      "import": "./dist/env.js",
      "default": "./dist/env.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "require": "./dist/constants.js",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "generate:css-vars": "tsx scripts/generate-css-vars.js",
    "generate:cn": "tsx scripts/generate-cn-groups.js",
    "generate": "npm run generate:css-vars && npm run generate:cn"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@nexus/contracts": "workspace:*",
    "tailwindcss": "3.4.3",
    "zod": "^3.23.8"
  }
}
