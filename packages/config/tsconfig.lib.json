{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "emitDeclarationOnly": false,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "composite": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../tokens"
    },
    {
      "path": "../env"
    },
    {
      "path": "../contracts/tsconfig.lib.json"
    }
  ]
}
