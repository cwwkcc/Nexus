{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@nexus/env/*": ["../env/src/*"],
      "@nexus/tokens": ["../tokens/src/index.ts"],
      "@nexus/contracts": ["../contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "**/__tests__/**"],
  "references": [
    {
      "path": "../tokens"
    },
    {
      "path": "../env"
    },
    {
      "path": "../contracts/tsconfig.lib.json"
    }
  ]
}
