generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PageContent {
  id         String   @id @default(cuid())
  page       String
  sectionKey String
  locale     String
  data       Json
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt
  updatedBy  String? // becomes a User relation once Task 6.3 (Auth) lands

  @@unique([page, sectionKey, locale])
  @@index([page])
}

model PageContentVersion {
  id         String   @id @default(cuid())
  page       String
  sectionKey String
  locale     String
  version    Int
  data       Json
  updatedAt  DateTime
  updatedBy  String?

  @@index([page, sectionKey, locale])
}
