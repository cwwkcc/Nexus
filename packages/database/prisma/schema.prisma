generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  si
  ta
}

enum ContentStatus {
  draft
  published
  archived
}

enum AlumniStatus {
  PENDING
  APPROVED
  REJECTED
}

model ContentEntry {
  id          String   @id @default(cuid())
  scope       String   
  sectionKey  String   
  locale      Locale   
  contentType String   
  status      ContentStatus   @default(draft)
  data        Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedBy   String? 

  versions    ContentEntryVersion[]

  @@unique([scope, sectionKey, locale])
  @@index([scope, locale])
  @@index([status])
}

model ContentEntryVersion {
  id             String       @id @default(cuid())
  contentEntryId String
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  version        Int
  data           Json
  changedAt      DateTime     @default(now())
  changedBy      String?

  @@unique([contentEntryId, version])
}

model SiteSetting {
  key       String   
  locale    Locale 
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([key, locale])
}

model NewsArticle {
  id          String    @id @default(cuid())
  locale      Locale
  slug        String
  title       String
  excerpt     String?
  // Tiptap/ProseMirror document (`{ type: 'doc', content: [...] }`), not an
  // HTML string — this is what RichTextEditor.tsx produces via
  // `editor.getJSON()` and what RichTextRenderer.tsx consumes directly as
  // its `value` prop. Was `String @db.Text` until M3; nothing had ever
  // written a real article through the (until-M3 nonfunctional)
  // RichTextEditor stub, so no data migration was needed for this change.
  content     Json
  category    String
  // Free-text byline (e.g. "School Media Team", a teacher's name) — not a
  // relation to User, since most articles are attributed to a group or a
  // non-admin-panel staff member, not necessarily a system account holder.
  author      String?
  status      ContentStatus @default(draft)
  featured    Boolean   @default(false)
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([category])
  @@index([featured])
}

// ─── Media Library (M4 — Task 7.8, F-067/F-115/F-120/F-169) ───────────────
//
// The R2 object key is the canonical, portable reference — the public CDN
// URL is derived at read time from R2_PUBLIC_URL + key (see
// modules/media/service.ts's `toUrl`) rather than stored, so a future CDN
// domain change never needs a data migration. Same reasoning as
// @nexus/contracts' ImageSchema doc comment ("Never store full CDN URLs —
// keys are portable if the CDN domain changes"), applied here to the row
// that actually owns the key.
//
// A row here only ever represents a confirmed, present R2 object — there is
// no draft/pending status the way NewsArticle has one. The presigned-PUT
// staging key a browser uploads to (see modules/media/router.ts's
// `requestUpload`) never gets a MediaAsset row at all unless `confirmUpload`
// completes; an abandoned client-side upload simply leaves an orphaned
// object under the `tmp/` prefix in R2, not a stuck row here, which is
// exactly F-062's "temporary upload artifacts" — a cleanup job cleans the
// bucket, this table stays clean by construction.
model MediaAsset {
  id       String @id @default(cuid())
  key      String @unique
  fileName String
  mimeType String
  fileSize Int

  /// Matches @nexus/contracts' UploadFolderEnum ('images' | 'documents' |
  /// 'media' | 'avatars') — stored as a plain string and validated at the
  /// Zod layer, the same convention as NewsArticle.category.
  folder String

  /// Populated only for image assets, after Sharp processing (F-115) —
  /// null for documents/audio/video.
  width  Int?
  height Int?

  altText String?
  caption String?
  tags    String[] @default([])

  uploadedBy String?
  uploader   User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([uploadedBy])
  @@index([createdAt])
}

// ─── Staff Module (M4 — Task 7.4, F-165) ───────────────────────────────────
//
// `role` and `department` are plain String columns validated against
// StaffRoleEnum/DepartmentKeyEnum (@nexus/contracts) at the Zod layer, the
// same convention NewsArticle.category and MediaAsset.folder already use
// for hyphenated, Zod-managed taxonomies — a native Postgres enum can't
// hold a bare identifier like `deputy-principal` without a `@map` that
// would desync the Prisma Client-facing value from the exact string the
// contracts package already exports and validates.
//
// `order` controls display sequence within one `role` group (F-165's
// drag-and-drop reorder) — scoped per-role, not global: "3rd deputy
// principal" and "3rd teacher" are independent orderings, and a single
// global sequence would force a re-number of every other role's rows every
// time one role's list was reordered.
//
// No draft/published status: StaffSchema (@nexus/contracts) never modeled
// one, and F-165's spec ("Create/edit ... Drag-and-drop reorder") doesn't
// call for one — every row is live on the public site as soon as it's
// saved, the same way MediaAsset has no draft state either. An editor who
// isn't ready to publish a profile simply doesn't create it yet. Removing
// someone is therefore a real (admin-role-only) delete, not an archive —
// see modules/staff/router.ts.
model Staff {
  id    String @id @default(cuid())
  name  String
  role  String
  title String

  /// DepartmentKeyEnum value — optional since not every role (principal,
  /// head-prefect) belongs to an academic department.
  department String?

  /// e.g. "Head of Mathematics Department" — distinct from `title` (e.g.
  /// "Deputy Principal (Academic)"), matching StaffSchema's own naming.
  portfolio String?

  tenure String?
  quote  String?
  bio    String?

  /// AvatarSchema's shape ({ src, alt }) split into two columns and
  /// reassembled into the nested object at the service layer's serialize()
  /// — the same flattened-storage-then-nest pattern NewsArticle.imageUrl
  /// uses for its cover image, just with the alt text a single-string
  /// field doesn't need. `portraitUrl` holds a full CDN URL (an
  /// R2_PUBLIC_URL-resolved MediaAsset.url), matching NewsArticle.imageUrl's
  /// established convention — not an R2 key, despite ImageSchema/
  /// AvatarSchema's own doc comment recommending keys; News already set
  /// this precedent and this module follows it for consistency rather than
  /// re-litigating storage format module-by-module.
  portraitUrl String?
  portraitAlt String?

  contactEmail String?
  joinedYear   String?

  /// Display order within `role`'s group (F-165 drag-and-drop reorder).
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Back-relation for Society.advisorStaffId (Task 7.6, F-167) — a
  /// staff member may advise zero or more societies. No display-order or
  /// other concern lives on this side; it exists purely so Prisma can
  /// model the relation bidirectionally.
  advisedSocieties Society[]

  /// Back-relation for ExtracurricularActivity.coachStaffId (Task 7.17,
  /// F-179) — same reasoning as advisedSocieties above, just for the
  /// separate Extracurriculars roster instead of Societies.
  coachedActivities ExtracurricularActivity[]

  @@index([role, order])
  @@index([department])
}

// ─── Societies (M4 — Task 7.6, F-147/F-148/F-167) ──────────────────────────
//
// Like NewsArticle/EventDetail (not like Staff): `locale` + a
// `(locale, slug)` unique index, one independently-authored row per
// language. A Society profile's identity fields (name, tagline,
// description, meetingSchedule, howToJoin) are prose that genuinely needs
// translation for a trilingual site, and F-167/Task 8.6 both require a
// routable `/societies/[slug]` detail page — the same two structural
// signals (prose content + a slug-routed individual page) that put
// CalendarEntry/EventDetail in the per-locale camp rather than Staff's
// single-global-row one (see schema.prisma's own note on Staff — a
// person's name/role/title are facts, not per-locale prose, and there's
// no individual staff page to route to).
//
// No draft/published/archived status, matching Staff's precedent, not
// News/EventDetail's: F-167's field list doesn't include one, and a
// school society either exists on the roster or doesn't — there's no
// realistic "written but not yet ready to announce" state for it the way
// there is for a news article or an event.
model Society {
  id     String @id @default(cuid())
  locale Locale
  slug   String

  name     String
  tagline  String?
  /// SocietyCategoryEnum value (academic/sports/arts/technology).
  category String

  foundingYear    String?
  description     String?
  meetingSchedule String?
  memberCount     Int?
  howToJoin       String?

  /// Same flattened-storage-then-nest pattern as Staff.portraitUrl/
  /// portraitAlt — see that model's own doc comment for the full
  /// reasoning (full CDN URL, not an R2 key).
  logoUrl   String?
  logoAlt   String?
  bannerUrl String?
  bannerAlt String?

  /// F-147: the Societies Hub renders one SocietyCard in the featured
  /// slot (KITS, this project's own society) when true.
  isFeatured Boolean @default(false)

  /// F-148's "advisor StaffCard" — nullable and `onDelete: SetNull`
  /// rather than `Cascade` or a required FK: a society keeps existing
  /// (and keeps its own page) if its advisor is ever removed from the
  /// staff roster, it just stops showing an advisor card until a new one
  /// is assigned. A required FK would make deleting any staff member who
  /// happens to advise a society throw a foreign-key violation, which is
  /// the wrong failure mode for an unrelated admin action.
  advisorStaffId String?
  advisorStaff   Staff?  @relation(fields: [advisorStaffId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([category])
  @@index([advisorStaffId])
}

// ─── Calendar & Events (M4 — Task 7.5, F-145/F-146/F-166/F-198) ────────────
//
// F-198 "Calendar-First Event Architecture" (see Feature Registry)
// supersedes the plain Task 7.5 spec ("Event model + migration") and the
// old standalone EventSchema in @nexus/contracts — nothing reaches the
// public site as an "event" except through a CalendarEntry row.
// CalendarEntry is the single source of truth for every dated item on the
// platform: holidays, exam dates, sports fixtures, cultural events,
// internal meetings, prize-givings. A CalendarEntry optionally carries a
// linked EventDetail — the fields the old standalone EventSchema defined
// beyond what CalendarEntry itself already covers (id/title/date/category
// move onto CalendarEntry; description/coverImage/location/isAllDay/
// registrationUrl stay on the detail) — which is what actually produces a
// public EventCard (F-024) and a routable /events/[slug] page (F-146). A
// calendar-only entry (a public holiday, an internal staff meeting) has no
// EventDetail, is never rendered as a card, and has no detail route.
model CalendarEntry {
  id     String @id @default(cuid())
  locale Locale

  title String
  /// Date-only identity for the calendar grid — F-198's carried-over field
  /// list for EventDetail names slug/description/coverImage/location/
  /// isAllDay/registrationUrl explicitly and does not include a second
  /// `endDate`; a multi-day event is represented as one CalendarEntry
  /// whose EventDetail states the span in its description, not a second
  /// date column. A real multi-day-span UI is a reasonable future
  /// enhancement, not silently dropped scope — flagged here rather than
  /// worked around with an unrequested field.
  date DateTime @db.Date

  /// EventCategorySchema value (academic/sports/cultural/exam/holiday/
  /// other) — plain String validated at the Zod layer, the same
  /// hyphenated-taxonomy convention NewsArticle.category, MediaAsset.folder,
  /// and Staff.role/department already established.
  category String

  isRecurring    Boolean @default(false)
  recurrenceRule String?
  notes          String?

  eventDetail EventDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, date])
  @@index([category])
}

/// Attached 1:1 to a CalendarEntry — see CalendarEntry's own doc comment.
/// `locale` is denormalized from the parent (kept in sync by
/// modules/events/service.ts, never independently editable — a detail
/// always lives in its calendar entry's own locale) purely so the public
/// /events/[slug] route can look a detail up by (locale, slug) with one
/// indexed unique-constraint query instead of a join filter, matching
/// NewsArticle's (locale, slug) convention exactly.
model EventDetail {
  id              String        @id @default(cuid())
  calendarEntryId String        @unique
  calendarEntry   CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  locale Locale
  slug   String

  description String

  coverImageUrl String?
  coverImageAlt String?

  location String?
  /// Free-text ("10:00 AM", "2:00 – 4:00 PM") — Engineering Roadmap Task
  /// 7.5's spec explicitly asks for a time field and EventCardSchema.time/
  /// EventCard's DateBlock both expect one, even though F-198's own
  /// carried-over field enumeration doesn't name it outright. Null
  /// whenever isAllDay is true.
  startTime String?
  isAllDay  Boolean @default(false)

  registrationUrl String?

  /// F-166: "Status workflow (draft → published → archived) applies to the
  /// EventDetail half only; a calendar-only entry has no publish state of
  /// its own." Reuses ContentStatus, the same enum NewsArticle.status uses.
  status ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
}

// ─── Gallery (M4 — Task 7.7, F-151/F-152/F-168) ────────────────────────────
//
// Same per-locale-row shape as Society/EventDetail (`locale` +
// `(locale, slug)`), not Staff's single-global-row one — title/description
// are prose that needs translation, and F-152/Task 8.9 require an
// individually routable `/gallery/[slug]` album page with
// `generateStaticParams` (F-112). One real wrinkle unique to this model:
// the *photos* inside an album are physical image files, not per-locale
// prose — re-uploading the same picture three times (once per language)
// would be wasteful. This schema still keeps each locale's GalleryAlbum
// row with its own independent set of GalleryPhoto rows (an English album
// and a Sinhala album are two separate album rows, each with their own
// photos), same as every other locale-scoped entity — but nothing stops
// an editor authoring the Sinhala album from picking the *same*
// already-uploaded Media Library asset URL for a photo instead of
// re-uploading the file, so the same underlying R2 object can be
// referenced by photo rows under multiple locale-rows without
// duplicating storage. What differs, and should, is each locale's own
// alt text/caption — translated per row like everything else here.
model GalleryAlbum {
  id     String @id @default(cuid())
  locale Locale
  slug   String

  title       String
  description String?
  /// Free text, not a closed enum — no gallery category taxonomy is
  /// defined anywhere (unlike Events/Societies), and neither Task 7.7's
  /// field table nor F-168 specifies one, so this keeps the original
  /// pre-relocation entity schema's own choice rather than inventing a
  /// taxonomy nothing asked for.
  category String?
  /// Task 7.7 asks for "year", not a full date (contrast with the old,
  /// now-relocated GalleryAlbumSchema's `date: string` — see
  /// editorial/gallery/album.ts's header comment) — F-151 "Albums sorted
  /// by year" confirms year-level organization is genuinely all that's
  /// wanted here.
  year Int

  /// Denormalized copy of the chosen cover photo's `src`/`alt` at
  /// selection time — not a live FK to a GalleryPhoto row. A real FK
  /// would need two named relations between GalleryAlbum and
  /// GalleryPhoto (the existing one-to-many `photos`, plus a reverse
  /// one-to-one "this album's cover") purely to save re-copying two
  /// strings; simpler, and the only real cost is that editing a photo's
  /// alt text after it's been chosen as a cover doesn't retroactively
  /// update the cover's own alt copy — an acceptable, documented
  /// staleness window for a field that's edited far less often than it's
  /// read.
  coverPhotoUrl String?
  coverPhotoAlt String?

  /// F-168 drag-and-drop album reordering, same pattern as Staff.order.
  order Int @default(0)

  photos GalleryPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, year])
  @@index([category])
}

model GalleryPhoto {
  id      String       @id @default(cuid())
  albumId String
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  /// Full CDN URL (an already-uploaded MediaAsset's `.url`), matching
  /// Staff.portraitUrl/Society.logoUrl's established convention — not an
  /// R2 key needing separate resolution.
  src String
  /// Required — F-168: "Per-photo alt text | Required — accessibility
  /// compliance." Deliberately not nullable, unlike every other alt-text
  /// field elsewhere in this schema.
  alt     String
  caption String?

  /// Display sequence within the album lightbox. New photos from a batch
  /// upload append at the end (current max + 1); reordered via move-up/
  /// move-down actions in the admin album form, not full drag-and-drop —
  /// F-168's own "Reorder" line is about *album* ordering (Task 7.7's
  /// field table lists it directly under the admin list, not under an
  /// individual album's editor), so this is a deliberately lighter-weight
  /// but still real, keyboard-operable affordance, not a silently-dropped
  /// requirement.
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId, order])
}

// ─── Announcements (M4 — Task 6.10/7.13, F-031/F-172) ──────────────────────
//
// Resolves this task's own open question in the Completion Plan checklist
// ("Confirm data shape — may ride on SiteSetting or need its own model")
// definitively: SiteSetting is a key-value singleton (`@@id([key, locale])`
// — one row per key per locale, nothing more), and F-172 explicitly
// requires "View all active AND PAST" announcements plus individually
// "deactivate or delete" — a growing list of independently-lifecycled
// records, which is exactly what SiteSetting can't represent without
// cramming an array into one JSON blob under a single key (the same
// ContentEntry-placeholder anti-pattern this codebase has already
// removed for News/Events/Societies/Gallery, not something to introduce
// fresh here). A real model, like every other content type before it.
//
// Locale-scoped per row (`locale` + no slug, no individual page — a
// banner has no route to be individually generated for, unlike every
// other M4 content type) — `message` is prose that needs translating,
// the same reasoning as everywhere else, just without the slug/
// generateStaticParams half those other models also needed.
//
// No draft/published/archived ContentStatus — matching Staff/Society/
// GalleryAlbum's precedent (see those models' own doc comments), not
// News/EventDetail's. F-172's own two states are `isActive` (an explicit
// manual toggle — "Deactivate") and time-bounded visibility
// (`publishAt`/`expiresAt` — "publish date, optional expiry"). Public
// visibility is the conjunction of all three:
// `isActive && publishAt <= now && (expiresAt == null || expiresAt > now)`
// — computed at query time in modules/announcements/service.ts, not
// stored, so it can never drift out of sync with the current time the
// way a cached `status` column could.
model Announcement {
  id     String @id @default(cuid())
  locale Locale

  /// AnnouncementBanner's own variant union (@nexus/ui) — 'info' |
  /// 'warning' | 'error', plain String validated at the Zod layer like
  /// every other closed-taxonomy field in this schema. Not the same
  /// enum as the *unrelated* page-embeddable `AnnouncementSchema` block
  /// (packages/contracts/src/blocks/generic/announcement.ts), which adds
  /// a fourth 'success' value for a different purpose entirely (a
  /// one-off notice authored into a specific page's own content, not a
  /// site-wide scheduled banner) — that block schema is untouched by
  /// this task.
  variant String @default("info")
  message String

  linkLabel String?
  linkHref  String?

  /// "Scheduling" (Task 6.10) — an announcement can be created now for a
  /// future publishAt, not just an immediate one; defaults to "now" at
  /// creation so an admin who doesn't touch this field gets immediate
  /// publication, the common case.
  publishAt DateTime @default(now())
  expiresAt DateTime?

  /// The explicit "Deactivate" action from F-172 — independent of
  /// publishAt/expiresAt, since an admin may need to pull an announcement
  /// early regardless of its scheduled expiry.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, isActive, publishAt])
}

// ─── Extracurriculars (M4 — Task 7.17, F-161/F-179) ────────────────────────
//
// Per-locale row (`locale` + no slug, no individual page) — the same shape
// as Announcement, not Society/GalleryAlbum: `description` (and
// `studentQuote`) are prose that needs translating for a trilingual site,
// the same signal that puts every per-locale model in this schema in that
// camp, but F-161's own field list — ExtracurricularCard via a single
// listing page grouped by category — never asks for an individually
// routable detail page the way F-148/F-152/F-146 do for Society/Gallery/
// EventDetail. So this table gets Announcement's lighter shape (no slug,
// no generateStaticParams) rather than Society's. (The admin stub this
// module replaced also mentioned an "ExtracurricularsJoinCTA section" —
// that doesn't correspond to anything in "Design System/Page
// Specifications.md" section 09 or an existing @nexus/ui component; see
// apps/web/src/app/[locale]/extracurriculars/page.tsx's own header
// comment for where that's flagged.)
//
// `coachStaffId` is a real FK to Staff (F-179: "coach/advisor via staff
// selection"), nullable and `onDelete: SetNull` for the exact same reason
// as Society.advisorStaffId — an activity outlives whichever staff member
// currently coaches it. The public card's own free-text `teacherInCharge`
// field (@nexus/contracts' ActivitySchema — a display projection, not this
// entity) is resolved from this FK at the service layer, the same
// resolve-then-project pattern Society's advisor already established for
// its own StaffCard.
//
// `isActive` (F-179: "active/inactive status") is the one real structural
// difference from Society/Staff/GalleryAlbum's "no draft/published state"
// precedent: F-179's own words — "Unlike Academic Programs, activities
// genuinely get added and retired over the years" — describe a permanent
// retirement flag, not a draft-review workflow, so this reuses
// Announcement.isActive's plain-Boolean shape (not NewsArticle/EventDetail's
// three-state ContentStatus). Filtered at query time in
// modules/extracurriculars/service.ts's public `list` only — the admin
// list still shows retired activities so an editor can reactivate one.
//
// No `order` field: F-179's spec doesn't ask for drag-and-drop reordering
// the way F-165/F-168 explicitly do for Staff/GalleryAlbum, so both the
// public and admin lists sort by category then name — deterministic
// without inventing a field nothing requested.
model ExtracurricularActivity {
  id     String @id @default(cuid())
  locale Locale

  name String
  /// ExtracurricularCategoryEnum value (sports/performing-arts/leadership).
  category String

  description String

  /// Optional per-card flourish — @nexus/ui's ExtracurricularCard only
  /// renders this for the 'performing-arts' variant. Matches
  /// ActivitySchema's own optional `studentQuote`.
  studentQuote String?
  /// Free text (e.g. "Jan – Mar term"), matches ActivitySchema.season.
  season String?

  /// F-179's "coach/advisor via staff selection" — see this model's own
  /// header comment for the SetNull reasoning.
  coachStaffId String?
  coachStaff   Staff?  @relation(fields: [coachStaffId], references: [id], onDelete: SetNull)

  /// Same flattened-storage-then-nest pattern as Staff.portraitUrl/
  /// Society.logoUrl — a full CDN URL, not an R2 key.
  photoUrl String?
  photoAlt String?

  /// F-179's "active/inactive status" — see this model's own header
  /// comment for why this is a plain Boolean, not ContentStatus.
  isActive Boolean @default(true)

  achievements ExtracurricularAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, category])
  @@index([locale, isActive])
  @@index([coachStaffId])
}

/// F-179's "achievements" — a structured record earned through one
/// activity, distinct from the school-wide `Achievement` model (Task
/// 7.19, home page + a dedicated achievements list — see
/// @nexus/contracts' editorial/achievements/achievement.ts header comment
/// for that separate entity). No independent lifecycle outside its
/// activity, the same reasoning as GalleryPhoto/GalleryAlbum — cascades on
/// delete, and is reconciled as a single array on the activity's own
/// create/update input rather than separate add/remove mutations (see
/// modules/extracurriculars/validators.ts's header comment).
model ExtracurricularAchievement {
  id         String                   @id @default(cuid())
  activityId String
  activity   ExtracurricularActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)

  title       String
  description String?
  /// AchievementLevel value (national/provincial/district/school) — the
  /// same taxonomy the school-wide Achievement model will reuse (Task
  /// 7.19), not a parallel one invented for this table alone.
  level String
  date  DateTime @db.Date

  awardedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId, date])
}

// ─── Authentication (M1a — Task 6.3/6.5, F-057/F-073/F-078) ────────────────
//
// Account/Session/VerificationToken follow the canonical Auth.js Prisma
// adapter shape verbatim so `@auth/prisma-adapter` works with zero mapping
// code. Sessions use Auth.js's "database" strategy, not JWT — every active
// session is a real row here and can be revoked server-side (F-081) by
// deleting it, not just by waiting out a token's expiry.
//
// Google Workspace OAuth (F-073) is not wired until M1b. Today the only
// provider is the Credentials-based break-glass account (F-078) — the
// passwordHash/TOTP fields below exist solely for that one account. Every
// other admin authenticates via Account (provider = "google") once M1b
// lands and never touches passwordHash or the TOTP fields at all.

enum UserRole {
  admin
  editor
  viewer
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(editor)

  /// F-081 — users are deactivated, never deleted, so audit history stays
  /// attributable. A deactivated user's sessions are also revoked; see
  /// apps/admin/src/lib/auth.ts's `session` callback.
  isActive Boolean @default(true)

  /// Break-glass account only (F-078). Bcrypt hash; null for every
  /// Google-provisioned admin, which has no password in this system at all.
  passwordHash String?

  /// Break-glass account only (F-080). Encrypted-at-rest is out of scope for
  /// this milestone (single-server deploy, disk-level encryption per
  /// ADR-006-adjacent ops posture) — treated as a secret at the same level
  /// as passwordHash, never returned by any tRPC procedure or logged.
  totpSecret    String?
  totpEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  backupCodes  BackupCode[]
  /// onDelete: SetNull on the other side (MediaAsset.uploader) — in
  /// practice this never fires today since F-081 deactivates users rather
  /// than deleting them, but it's the correct behavior if that ever
  /// changes: an asset outlives the account that uploaded it.
  mediaAssets  MediaAsset[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use TOTP recovery codes for the break-glass account (F-080).
/// Hashed at rest like passwordHash. Marked `usedAt` rather than deleted on
/// redemption, so "was this code already spent" stays answerable without an
/// audit-log cross-reference.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Alumni (M4 — Task 7.18, F-154/F-180) ────────────────────────────────
//
// Unlike Staff/Society/ExtracurricularActivity (single global row or
// per-locale row with a slug), AlumniProfile has neither `locale` nor a
// `slug` — it's a single global directory record. An alumnus's name,
// graduation year, current role, and quote are facts, not per-locale prose,
// and F-154/F-180 both describe a single searchable directory (not three
// language-specific directories). The only translation concern would be
// if the directory itself needed translated UI labels, which is a
// presentation-layer concern, not a data-model one.
//
// The key distinction from other M4 modules is the moderation workflow:
// public submissions arrive as `PENDING` and await admin approval
// (F-180's "two entry paths" requirement), while admin-direct entries
// can be created as `APPROVED` immediately. `REJECTED` carries an optional
// `rejectionReason` for audit purposes. No draft/published/archived
// `ContentStatus` — the moderation workflow itself is the publication gate.
model AlumniProfile {
  id    String @id @default(cuid())
  name  String

  /// e.g. "2023" — stored as string to match AlumniSchema's existing
  /// convention and to support future non-year formats if needed.
  graduationYear String

  /// ALStreamEnum value — optional since not every alumnus's stream is
  /// relevant to their current career or may not be known.
  stream String?

  /// e.g. "Software Engineer" — matches AlumniSchema's `currentRole`.
  currentRole String?

  /// e.g. "Google" — matches AlumniSchema's `currentOrg`.
  currentOrg String?

  /// AvatarSchema's shape ({ src, alt }) split into two columns and
  /// reassembled into the nested object at the service layer's serialize()
  /// — the same flattened-storage-then-nest pattern Staff.portraitUrl/
  /// portraitAlt and NewsArticle.imageUrl use. Full CDN URL (an
  /// R2_PUBLIC_URL-resolved MediaAsset.url), not an R2 key.
  portraitUrl String?
  portraitAlt String?

  /// Optional quote for feature-worthy alumni — displayed on the public
  /// directory if present.
  quote String?

  /// Flag for homepage/higher-visibility display — F-154's "featured alumni"
  /// concept, distinct from the general directory listing.
  isFeatureworthy Boolean @default(false)

  /// Moderation status — PENDING for public submissions, APPROVED for
  /// published profiles, REJECTED for discarded submissions with an
  /// optional audit reason.
  status AlumniStatus @default(PENDING)

  /// Optional reason for rejection — logged when an admin rejects a
  /// pending submission (F-180's "discard with optional logged reason").
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([graduationYear])
}

// ─── Achievements (M4 — Task 7.19, F-156/F-181) ───────────────────────────────
//
// Like AlumniProfile (not like Society/EventDetail), Achievement has no
// `locale` field — school-wide achievements are facts, not per-locale prose.
// A student's name, achievement level, and date don't need translation; only
// the surrounding page chrome (hero, section titles) does, which is handled
// by ContentEntry. No draft/published/archived ContentStatus — the same
// simple create/edit/delete shape as Events (F-181's own wording: "no
// draft/review workflow").
//
// The AchievementSchema in @nexus/contracts (`editorial/achievements/`)
// is the ContentEntry-era contract; this Prisma model is the real
// domain model that replaced it. The card schema (AchievementCardSchema)
// survives unchanged since @nexus/ui renders directly from it.
model Achievement {
  id          String @id @default(cuid())
  title       String
  description String?

  /// AchievementLevelEnum value — national/provincial/district/school.
  level String

  /// AchievementCategoryEnum value — academic/sports/cultural/other.
  category String

  /// Full ISO date string — @db.Date is insufficient since achievements
  /// may need year+month precision (e.g. "March 2025") rather than just year.
  date String

  /// Optional awarding body (e.g. "Ministry of Education").
  awardedBy String?

  /// ImageSchema's shape ({ src, alt }) split into two columns and
  /// reassembled into the nested object at the service layer's serialize()
  /// — the same flattened-storage-then-nest pattern every other module
  /// with an image field uses. Full CDN URL (an R2_PUBLIC_URL-resolved
  /// MediaAsset.url), not an R2 key.
  imageUrl String?
  imageAlt String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
}

// ─── Digital Archive (M4 — Task 7.20, F-155/F-182) ───────────────────────────
//
// Like Achievement/AlumniProfile (not like Society/EventDetail), Archive has
// no `locale` field — historical documents are facts, not per-locale prose.
// No draft/published/archived ContentStatus — simple create/edit/delete shape.
// Curated content layer over Media Library: each entry references a file
// uploaded through the standard Media Library pipeline, with metadata
// (title, year, category, description) that the Media Library alone doesn't
// have (F-182: "the Media Library alone has no concept of 'this PDF is the
// 1987 prefects list'").
//
// Categories: photograph, magazine, prize-giving record, prefect list.
// The `file` field stores a full CDN URL (an R2_PUBLIC_URL-resolved
// MediaAsset.url), not an R2 key — the same pattern every other module
// with an image field uses.
model Archive {
  id          String @id @default(cuid())
  title       String
  year        String

  /// ArchiveCategoryEnum value — photograph/magazine/prize_giving_record/prefect_list
  /// (hyphenated strings for enum compatibility with Prisma).
  category String

  description String?

  /// ImageSchema's shape ({ src, alt }) split into two columns and
  /// reassembled into the nested object at the service layer's serialize()
  /// — the same flattened-storage-then-nest pattern every other module
  /// with an image field uses. Full CDN URL (an R2_PUBLIC_URL-resolved
  /// MediaAsset.url), not an R2 key.
  fileUrl String
  fileAlt String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([year])
}
