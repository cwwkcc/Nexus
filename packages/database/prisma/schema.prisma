generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  si
  ta
}

enum ContentStatus {
  draft
  published
  archived
}

model ContentEntry {
  id          String   @id @default(cuid())
  scope       String   
  sectionKey  String   
  locale      Locale   
  contentType String   
  status      ContentStatus   @default(draft)
  data        Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedBy   String? 

  versions    ContentEntryVersion[]

  @@unique([scope, sectionKey, locale])
  @@index([scope, locale])
  @@index([status])
}

model ContentEntryVersion {
  id             String       @id @default(cuid())
  contentEntryId String
  contentEntry   ContentEntry @relation(fields: [contentEntryId], references: [id], onDelete: Cascade)
  version        Int
  data           Json
  changedAt      DateTime     @default(now())
  changedBy      String?

  @@unique([contentEntryId, version])
}

model SiteSetting {
  key       String   
  locale    Locale 
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@id([key, locale])
}

model NewsArticle {
  id          String    @id @default(cuid())
  locale      Locale
  slug        String
  title       String
  excerpt     String?
  // Tiptap/ProseMirror document (`{ type: 'doc', content: [...] }`), not an
  // HTML string — this is what RichTextEditor.tsx produces via
  // `editor.getJSON()` and what RichTextRenderer.tsx consumes directly as
  // its `value` prop. Was `String @db.Text` until M3; nothing had ever
  // written a real article through the (until-M3 nonfunctional)
  // RichTextEditor stub, so no data migration was needed for this change.
  content     Json
  category    String
  // Free-text byline (e.g. "School Media Team", a teacher's name) — not a
  // relation to User, since most articles are attributed to a group or a
  // non-admin-panel staff member, not necessarily a system account holder.
  author      String?
  status      ContentStatus @default(draft)
  featured    Boolean   @default(false)
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([category])
  @@index([featured])
}

// ─── Media Library (M4 — Task 7.8, F-067/F-115/F-120/F-169) ───────────────
//
// The R2 object key is the canonical, portable reference — the public CDN
// URL is derived at read time from R2_PUBLIC_URL + key (see
// modules/media/service.ts's `toUrl`) rather than stored, so a future CDN
// domain change never needs a data migration. Same reasoning as
// @nexus/contracts' ImageSchema doc comment ("Never store full CDN URLs —
// keys are portable if the CDN domain changes"), applied here to the row
// that actually owns the key.
//
// A row here only ever represents a confirmed, present R2 object — there is
// no draft/pending status the way NewsArticle has one. The presigned-PUT
// staging key a browser uploads to (see modules/media/router.ts's
// `requestUpload`) never gets a MediaAsset row at all unless `confirmUpload`
// completes; an abandoned client-side upload simply leaves an orphaned
// object under the `tmp/` prefix in R2, not a stuck row here, which is
// exactly F-062's "temporary upload artifacts" — a cleanup job cleans the
// bucket, this table stays clean by construction.
model MediaAsset {
  id       String @id @default(cuid())
  key      String @unique
  fileName String
  mimeType String
  fileSize Int

  /// Matches @nexus/contracts' UploadFolderEnum ('images' | 'documents' |
  /// 'media' | 'avatars') — stored as a plain string and validated at the
  /// Zod layer, the same convention as NewsArticle.category.
  folder String

  /// Populated only for image assets, after Sharp processing (F-115) —
  /// null for documents/audio/video.
  width  Int?
  height Int?

  altText String?
  caption String?
  tags    String[] @default([])

  uploadedBy String?
  uploader   User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([uploadedBy])
  @@index([createdAt])
}

// ─── Staff Module (M4 — Task 7.4, F-165) ───────────────────────────────────
//
// `role` and `department` are plain String columns validated against
// StaffRoleEnum/DepartmentKeyEnum (@nexus/contracts) at the Zod layer, the
// same convention NewsArticle.category and MediaAsset.folder already use
// for hyphenated, Zod-managed taxonomies — a native Postgres enum can't
// hold a bare identifier like `deputy-principal` without a `@map` that
// would desync the Prisma Client-facing value from the exact string the
// contracts package already exports and validates.
//
// `order` controls display sequence within one `role` group (F-165's
// drag-and-drop reorder) — scoped per-role, not global: "3rd deputy
// principal" and "3rd teacher" are independent orderings, and a single
// global sequence would force a re-number of every other role's rows every
// time one role's list was reordered.
//
// No draft/published status: StaffSchema (@nexus/contracts) never modeled
// one, and F-165's spec ("Create/edit ... Drag-and-drop reorder") doesn't
// call for one — every row is live on the public site as soon as it's
// saved, the same way MediaAsset has no draft state either. An editor who
// isn't ready to publish a profile simply doesn't create it yet. Removing
// someone is therefore a real (admin-role-only) delete, not an archive —
// see modules/staff/router.ts.
model Staff {
  id    String @id @default(cuid())
  name  String
  role  String
  title String

  /// DepartmentKeyEnum value — optional since not every role (principal,
  /// head-prefect) belongs to an academic department.
  department String?

  /// e.g. "Head of Mathematics Department" — distinct from `title` (e.g.
  /// "Deputy Principal (Academic)"), matching StaffSchema's own naming.
  portfolio String?

  tenure String?
  quote  String?
  bio    String?

  /// AvatarSchema's shape ({ src, alt }) split into two columns and
  /// reassembled into the nested object at the service layer's serialize()
  /// — the same flattened-storage-then-nest pattern NewsArticle.imageUrl
  /// uses for its cover image, just with the alt text a single-string
  /// field doesn't need. `portraitUrl` holds a full CDN URL (an
  /// R2_PUBLIC_URL-resolved MediaAsset.url), matching NewsArticle.imageUrl's
  /// established convention — not an R2 key, despite ImageSchema/
  /// AvatarSchema's own doc comment recommending keys; News already set
  /// this precedent and this module follows it for consistency rather than
  /// re-litigating storage format module-by-module.
  portraitUrl String?
  portraitAlt String?

  contactEmail String?
  joinedYear   String?

  /// Display order within `role`'s group (F-165 drag-and-drop reorder).
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role, order])
  @@index([department])
}

// ─── Calendar & Events (M4 — Task 7.5, F-145/F-146/F-166/F-198) ────────────
//
// F-198 "Calendar-First Event Architecture" (see Feature Registry)
// supersedes the plain Task 7.5 spec ("Event model + migration") and the
// old standalone EventSchema in @nexus/contracts — nothing reaches the
// public site as an "event" except through a CalendarEntry row.
// CalendarEntry is the single source of truth for every dated item on the
// platform: holidays, exam dates, sports fixtures, cultural events,
// internal meetings, prize-givings. A CalendarEntry optionally carries a
// linked EventDetail — the fields the old standalone EventSchema defined
// beyond what CalendarEntry itself already covers (id/title/date/category
// move onto CalendarEntry; description/coverImage/location/isAllDay/
// registrationUrl stay on the detail) — which is what actually produces a
// public EventCard (F-024) and a routable /events/[slug] page (F-146). A
// calendar-only entry (a public holiday, an internal staff meeting) has no
// EventDetail, is never rendered as a card, and has no detail route.
model CalendarEntry {
  id     String @id @default(cuid())
  locale Locale

  title String
  /// Date-only identity for the calendar grid — F-198's carried-over field
  /// list for EventDetail names slug/description/coverImage/location/
  /// isAllDay/registrationUrl explicitly and does not include a second
  /// `endDate`; a multi-day event is represented as one CalendarEntry
  /// whose EventDetail states the span in its description, not a second
  /// date column. A real multi-day-span UI is a reasonable future
  /// enhancement, not silently dropped scope — flagged here rather than
  /// worked around with an unrequested field.
  date DateTime @db.Date

  /// EventCategorySchema value (academic/sports/cultural/exam/holiday/
  /// other) — plain String validated at the Zod layer, the same
  /// hyphenated-taxonomy convention NewsArticle.category, MediaAsset.folder,
  /// and Staff.role/department already established.
  category String

  isRecurring    Boolean @default(false)
  recurrenceRule String?
  notes          String?

  eventDetail EventDetail?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, date])
  @@index([category])
}

/// Attached 1:1 to a CalendarEntry — see CalendarEntry's own doc comment.
/// `locale` is denormalized from the parent (kept in sync by
/// modules/events/service.ts, never independently editable — a detail
/// always lives in its calendar entry's own locale) purely so the public
/// /events/[slug] route can look a detail up by (locale, slug) with one
/// indexed unique-constraint query instead of a join filter, matching
/// NewsArticle's (locale, slug) convention exactly.
model EventDetail {
  id              String        @id @default(cuid())
  calendarEntryId String        @unique
  calendarEntry   CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)

  locale Locale
  slug   String

  description String

  coverImageUrl String?
  coverImageAlt String?

  location String?
  /// Free-text ("10:00 AM", "2:00 – 4:00 PM") — Engineering Roadmap Task
  /// 7.5's spec explicitly asks for a time field and EventCardSchema.time/
  /// EventCard's DateBlock both expect one, even though F-198's own
  /// carried-over field enumeration doesn't name it outright. Null
  /// whenever isAllDay is true.
  startTime String?
  isAllDay  Boolean @default(false)

  registrationUrl String?

  /// F-166: "Status workflow (draft → published → archived) applies to the
  /// EventDetail half only; a calendar-only entry has no publish state of
  /// its own." Reuses ContentStatus, the same enum NewsArticle.status uses.
  status ContentStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
}

// ─── Authentication (M1a — Task 6.3/6.5, F-057/F-073/F-078) ────────────────
//
// Account/Session/VerificationToken follow the canonical Auth.js Prisma
// adapter shape verbatim so `@auth/prisma-adapter` works with zero mapping
// code. Sessions use Auth.js's "database" strategy, not JWT — every active
// session is a real row here and can be revoked server-side (F-081) by
// deleting it, not just by waiting out a token's expiry.
//
// Google Workspace OAuth (F-073) is not wired until M1b. Today the only
// provider is the Credentials-based break-glass account (F-078) — the
// passwordHash/TOTP fields below exist solely for that one account. Every
// other admin authenticates via Account (provider = "google") once M1b
// lands and never touches passwordHash or the TOTP fields at all.

enum UserRole {
  admin
  editor
  viewer
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(editor)

  /// F-081 — users are deactivated, never deleted, so audit history stays
  /// attributable. A deactivated user's sessions are also revoked; see
  /// apps/admin/src/lib/auth.ts's `session` callback.
  isActive Boolean @default(true)

  /// Break-glass account only (F-078). Bcrypt hash; null for every
  /// Google-provisioned admin, which has no password in this system at all.
  passwordHash String?

  /// Break-glass account only (F-080). Encrypted-at-rest is out of scope for
  /// this milestone (single-server deploy, disk-level encryption per
  /// ADR-006-adjacent ops posture) — treated as a secret at the same level
  /// as passwordHash, never returned by any tRPC procedure or logged.
  totpSecret    String?
  totpEnabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  backupCodes  BackupCode[]
  /// onDelete: SetNull on the other side (MediaAsset.uploader) — in
  /// practice this never fires today since F-081 deactivates users rather
  /// than deleting them, but it's the correct behavior if that ever
  /// changes: an asset outlives the account that uploaded it.
  mediaAssets  MediaAsset[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use TOTP recovery codes for the break-glass account (F-080).
/// Hashed at rest like passwordHash. Marked `usedAt` rather than deleted on
/// redemption, so "was this code already spent" stays answerable without an
/// audit-log cross-reference.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
