{
  "name": "@nexus/tokens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc && npm run generate",
    "generate:css": "node scripts/generate-css-vars.js",
    "generate:cn": "node scripts/generate-cn-groups.js",
    "generate": "npm run generate:css && npm run generate:cn"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
