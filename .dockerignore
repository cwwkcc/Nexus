# Dependencies — reinstalled fresh inside the image every build
node_modules
**/node_modules

# Build outputs — regenerated fresh inside the image every build.
# (Excluding these also stops a stale local build from ever being
# copied in instead of a clean container-side build.)
**/.next
**/dist
.nx

# VCS / editor / OS noise
.git
.github
.vscode
.DS_Store

# Local env files — secrets are injected at runtime, never baked into the image
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*