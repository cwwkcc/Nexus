# Copy this to .env and fill in values. Never commit .env.

# --- Database ---
DATABASE_URL=""                  # PostgreSQL connection string
POSTGRES_PASSWORD=""             # Postgres container password (docker-compose.yml interpolates this for the `postgres` service — must match the password embedded in DATABASE_URL)

# --- Public URLs ---
NEXT_PUBLIC_SITE_URL=""          # e.g. https://cwwkcc.lk — required. packages/env/client.ts throws at build/boot if unset, and Next inlines it at `next build` time, not runtime
NEXT_PUBLIC_ADMIN_URL=""         # e.g. https://admin.cwwkcc.lk — required, same as above

# --- Auth.js ---
NEXTAUTH_SECRET=""               # Random 32-byte secret (openssl rand -hex 32)
NEXTAUTH_URL=""                  # https://admin.cwwkcc.lk

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""              # From Google Cloud Console
GOOGLE_CLIENT_SECRET=""          # From Google Cloud Console

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=""                 # Cloudflare account ID
R2_ACCESS_KEY_ID=""              # R2 access key
R2_SECRET_ACCESS_KEY=""          # R2 secret key
R2_BUCKET_NAME=""                # R2 bucket name
R2_PUBLIC_URL=""                 # Public CDN URL for R2 assets

# --- Resend (Email) ---
RESEND_API_KEY=""                # From resend.com

# --- Admin API / Revalidation ---
ADMIN_API_SECRET=""              # Bootstrap auth stub for adminProcedure (see packages/api/src/middleware/auth.ts). Optional for now — becomes required before production launch.
REVALIDATE_SECRET=""             # Shared secret for POST /api/revalidate (apps/web). Required — must match on both sides.

# --- Break-glass Account ---
ADMIN_EMAIL=""                   # Seeded at first deploy (F-064)
ADMIN_PASSWORD=""                # bcrypt-hashed at seed time

# --- Optional ---
SENTRY_DSN=""                    # Sentry error tracking (F-085). Leave blank to disable.
UMAMI_WEBSITE_ID=""              # Umami analytics site ID, server-side (F-087)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""  # Umami analytics site ID, client-side (F-087)